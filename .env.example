# xAI / Grok (server-only)
XAI_API_KEY=

# CARTO basemaps (Kaenz map). Removes the "API key required" watermark.
NEXT_PUBLIC_MAP_API_KEY=

# Supabase (Kaenz project — Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=https://kaenz.com

# Stripe (server Checkout + webhook). Test keys start with sk_test_ / whsec_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional Stripe Connect accounts for live splits (acct_...).
# If unset, Kaenz keeps the charge on the platform and records the split.
STRIPE_CONNECT_OWNER=
STRIPE_CONNECT_CAPTAIN=
STRIPE_CONNECT_MARINA_PICKUP=
STRIPE_CONNECT_MARINA_DROPOFF=

# Gmail: Google OAuth (redirect URI is always https://kaenz.com/api/auth/google/callback).
# Users are created/linked in the Kaenz Supabase project after Google succeeds.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# $SALVAZION access key (phase 1). Off unless SALVAZION_KEY_ENABLED is exactly 1.
# The threshold is a token quantity on the wallet saved in Account, not a price.
# SALVAZION_KEY_ENABLED=1
# SALVAZION_KEY_MIN_TOKENS=1
# SALVAZION_MINT=2XALhxGKCr2zCADkMANBq3b6rV7Zv5QF6RVZokgEAfUM
# SOLANA_RPC_URL=
